1d. Playfair cipher
---------------------------------------------------------------------

CORRECTED CODE (p1d_playfair.py):

def prepare_key(key):
    key = key.upper().replace(" ", "").replace("J", "I")
    matrix = [[""] * 5 for _ in range(5)]
    used = set()
    row = col = 0
    for letter in key + "ABCDEFGHIKLMNOPQRSTUVWXYZ":
        if letter.isalpha() and letter not in used:
            matrix[row][col] = letter
            used.add(letter)
            col += 1
            if col == 5:
                col = 0
                row += 1
    return matrix


def find_position(matrix, letter):
    for i in range(5):
        for j in range(5):
            if matrix[i][j] == letter:
                return i, j


def prepare_text(text):
    """Remove non-letters, J->I, split doubled letters with X, pad odd length with X."""
    text = "".join(c for c in text.upper() if c.isalpha()).replace("J", "I")
    pairs = []
    i = 0
    while i < len(text):
        a = text[i]
        if i + 1 < len(text):
            b = text[i + 1]
            if a == b:
                pairs.append(a + "X")
                i += 1
            else:
                pairs.append(a + b)
                i += 2
        else:
            pairs.append(a + "X")
            i += 1
    return pairs


def process(pairs, matrix, shift):
    out = ""
    for pair in pairs:
        ra, ca = find_position(matrix, pair[0])
        rb, cb = find_position(matrix, pair[1])
        if ra == rb:
            out += matrix[ra][(ca + shift) % 5] + matrix[rb][(cb + shift) % 5]
        elif ca == cb:
            out += matrix[(ra + shift) % 5][ca] + matrix[(rb + shift) % 5][cb]
        else:
            out += matrix[ra][cb] + matrix[rb][ca]
    return out


def playfair_encrypt(plaintext, key):
    matrix = prepare_key(key)
    return process(prepare_text(plaintext), matrix, 1)


def playfair_decrypt(ciphertext, key):
    matrix = prepare_key(key)
    pairs = [ciphertext[i:i + 2] for i in range(0, len(ciphertext), 2)]
    return process(pairs, matrix, -1)


key_text = "HelloTYCS"
plain_text = "instruments"

print("Key matrix:")
for r in prepare_key(key_text):
