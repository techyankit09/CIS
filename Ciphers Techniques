cipher_text = playfair_encrypt(plain_text, key_text)
print("Key        :", key_text)
print("Plain text :", plain_text)
print("Cipher text:", cipher_text)
print("Decrypted  :", playfair_decrypt(cipher_text, key_text), "(X is padding)")

