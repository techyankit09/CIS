1c. Vernam cipher
---------------------------------------------------------------------

CORRECTED CODE (p1c_vernam.py):

def vernam_encrypt(text, key):
    if len(key) < len(text):
        raise ValueError("Vernam key must be at least as long as the text")
    out = ""
    for t, k in zip(text, key):
        out += chr((ord(t) - 65 + ord(k) - 65) % 26 + 65)
    return out


def vernam_decrypt(cipher, key):
    out = ""
    for c, k in zip(cipher, key):
        out += chr((ord(c) - 65 - (ord(k) - 65)) % 26 + 65)
    return out


plain_text = "HELLO"
key = "MONEY"
cipher = vernam_encrypt(plain_text.upper(), key.upper())
print("Plain text :", plain_text)
print("Key        :", key)
print("Cipher text:", cipher)
print("Decrypted  :", vernam_decrypt(cipher, key.upper()))

