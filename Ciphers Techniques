1e. Rail Fence cipher
---------------------------------------------------------------------

CORRECTED CODE (p1e_railfence.py):

def encryptRailFence(text, key):
    rail = [["\n"] * len(text) for _ in range(key)]
    dir_down = False
    row, col = 0, 0
    for ch in text:
        if row == 0 or row == key - 1:
            dir_down = not dir_down
        rail[row][col] = ch
        col += 1
        row += 1 if dir_down else -1
    return "".join(c for r in rail for c in r if c != "\n")


def decryptRailFence(cipher, key):
    rail = [["\n"] * len(cipher) for _ in range(key)]
    dir_down = None
    row, col = 0, 0
    for _ in cipher:                      # mark the zig-zag path
        if row == 0:
            dir_down = True
        if row == key - 1:
            dir_down = False
        rail[row][col] = "*"
        col += 1
        row += 1 if dir_down else -1

    index = 0
    for i in range(key):                  # fill the path row by row
        for j in range(len(cipher)):
            if rail[i][j] == "*" and index < len(cipher):
                rail[i][j] = cipher[index]
                index += 1

    result = []
    row, col = 0, 0
    for _ in cipher:                      # read the zig-zag
        if row == 0:
            dir_down = True
        if row == key - 1:
            dir_down = False
        result.append(rail[row][col])
        col += 1
        row += 1 if dir_down else -1
    return "".join(result)


if __name__ == "__main__":
    tests = [("TYCS", 2), ("Rail Fence ", 3), ("Computer", 3)]
    print("Encryption:")
    enc = []
    for t, k in tests:
        c = encryptRailFence(t, k)
        enc.append((c, k))
        print(f"  {t!r} (rails={k}) -> {c!r}")
    print("------------------------------")
    print("Decryption:")
    for c, k in enc:
        print(f"  {c!r} (rails={k}) -> {decryptRailFence(c, k)!r}")

