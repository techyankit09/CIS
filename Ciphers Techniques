import math

key = "TYCS"


def encryptMessage(msg):
    cipher = ""
    col = len(key)
    row = math.ceil(len(msg) / col)
    msg_lst = list(msg) + ["_"] * (row * col - len(msg))
    matrix = [msg_lst[i:i + col] for i in range(0, len(msg_lst), col)]
    # read columns in alphabetical order of the key letters
    for k in sorted(key):
        idx = key.index(k)
        cipher += "".join(r[idx] for r in matrix)
    return cipher


def decryptMessage(cipher):
    col = len(key)
    row = len(cipher) // col
    matrix = [[""] * col for _ in range(row)]
    pos = 0
    for k in sorted(key):
        idx = key.index(k)
        for r in range(row):
            matrix[r][idx] = cipher[pos]
            pos += 1
    return "".join("".join(r) for r in matrix).rstrip("_")


msg = "CyberForensic"
cipher = encryptMessage(msg)
print("Key              :", key)
print("Encrypted Message:", cipher)
print("Decrypted Message:", decryptMessage(cipher))

OUTPUT:

Key              : TYCS
Encrypted Message: bos_eri_CrecyFn_
Decrypted Message: CyberForensic
