1a. Caesar cipher
---------------------------------------------------------------------

CORRECTED CODE (p1a_caesar.py):

def encrypt_text(plaintext, n):
    ans = ""
    for ch in plaintext:
        if ch.isupper():
            ans += chr((ord(ch) - 65 + n) % 26 + 65)
        elif ch.islower():
            ans += chr((ord(ch) - 97 + n) % 26 + 97)
        else:
            ans += ch          # keep spaces, digits, punctuation unchanged
    return ans


def decrypt_text(ciphertext, n):
    return encrypt_text(ciphertext, -n)


