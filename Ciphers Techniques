import random
import string


def make_key():
    """Random monoalphabetic key: a shuffled alphabet."""
    letters = list(string.ascii_uppercase)
    random.shuffle(letters)
    return "".join(letters)


def encrypt(message, key):
    table = {string.ascii_uppercase[i]: key[i] for i in range(26)}
    out = ""
    for ch in message:
        if ch.isupper():
            out += table[ch]
        elif ch.islower():
            out += table[ch.upper()].lower()
        else:
            out += ch
    return out


def decrypt(cipher, key):
    table = {key[i]: string.ascii_uppercase[i] for i in range(26)}
    out = ""
    for ch in cipher:
        if ch.isupper():
            out += table[ch]
        elif ch.islower():
            out += table[ch.upper()].lower()
        else:
            out += ch
    return out


# Fixed key so the output is repeatable (use make_key() for a random one)
key = "QWERTYUIOPASDFGHJKLZXCVBNM"
