def encrypt_text(plaintext,n):
    ans=""
    for i in range(len(plaintext)):
        ch=plaintext[i]
        if ch==" ":
            ans+=" "
        elif(ch.isupper()):
            ans+=chr((ord(ch)+n-65)%26+65)
        else:
            ans+=chr((ord(ch)+n-97)%26+97)
    return ans

plaintext="A TYCS Caser Cipher practical example"
n=1
print("plain text:"+plaintext)
print("shift patter is:"+str(n))
print("chiper text:"+encrypt_text(plaintext,n))
