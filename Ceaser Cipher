def prepare_key(key):
    # Convert the key to uppercase and remove spaces
    key = key.upper().replace(" ", "")
    key = list(key)
    # Initialize the key matrix with empty cells
    key_matrix = [['' for _ in range(5)] for _ in range(5)]
    used_letters = set()
    row, col = 0, 0

    for letter in key:
        if letter not in used_letters:
            key_matrix[row][col] = letter
            used_letters.add(letter)
            col += 1
            if col == 5:
                col = 0
                row += 1

    alphabet = 'ABCDEFGHIKLMNOPQRSTUVWXYZ'
    for letter in alphabet:
        if letter not in used_letters:
            key_matrix[row][col] = letter
            used_letters.add(letter)
            col += 1
            if col == 5:
                col = 0
                row += 1

    return key_matrix

def find_position(matrix, letter):
    for i in range(5):
        for j in range(5):
            if matrix[i][j] == letter:
                return i, j

def playfair_encrypt(plaintext, key):
    key_matrix = prepare_key(key)
    plaintext = plaintext.upper().replace(" ", "")
    pairs = [plaintext[i:i+2] for i in range(0, len(plaintext), 2)]
    ciphertext = ""

    for pair in pairs:
        if len(pair) == 2:
            a, b = pair[0], pair[1]
            row_a, col_a = find_position(key_matrix, a)
            row_b, col_b = find_position(key_matrix, b)

            if row_a == row_b:
                ciphertext += key_matrix[row_a][(col_a + 1) % 5] + key_matrix[row_b][(col_b + 1) % 5]
            elif col_a == col_b:
                ciphertext += key_matrix[(row_a + 1) % 5][col_a] + key_matrix[(row_b + 1) % 5][col_b]
            else:
                ciphertext += key_matrix[row_a][col_b] + key_matrix[row_b][col_a]
        else:
            # Handle odd-length plaintext by adding an 'X' at the end
            a, b = pair[0], 'X'
            row_a, col_a = find_position(key_matrix, a)
            row_b, col_b = find_position(key_matrix, b)
            ciphertext += key_matrix[row_a][col_b] + key_matrix[row_b][col_a]

    return ciphertext

