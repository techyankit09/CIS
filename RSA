RSA
---------------------------------------------------------------------
import math

p = 3
q = 7
n = p * q
print("n =", n)
phi = (p - 1) * (q - 1)
print("phi =", phi)

e = 2
while e < phi:
    if math.gcd(e, phi) == 1:
        break
    e += 1
print("e =", e)

d = pow(e, -1, phi)          # modular inverse (works for any valid e)
print("d =", d)
print("Public Key :", (e, n))
print("Private Key:", (d, n))

msg = 11
print("Original message :", msg)
C = pow(msg, e, n)           # integer modular exponentiation
print("Encrypted message:", C)
M = pow(C, d, n)
print("Decrypted message:", M)

